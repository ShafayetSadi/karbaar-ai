# Any OpenAI-compatible chat completions endpoint with tool calling.
# OpenAI:      leave KARBAAR_LLM_BASE_URL empty, KARBAAR_LLM_MODEL=gpt-4o-mini
# Gemini:      KARBAAR_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#              KARBAAR_LLM_MODEL=gemini-3.1-flash-lite
# OpenRouter:  KARBAAR_LLM_BASE_URL=https://openrouter.ai/api/v1
#              KARBAAR_LLM_MODEL=google/gemini-3.1-flash-lite
KARBAAR_LLM_API_KEY=
KARBAAR_LLM_BASE_URL=
KARBAAR_LLM_MODEL=gpt-4o-mini

# Browser origins allowed to call the agent (comma separated).
KARBAAR_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
